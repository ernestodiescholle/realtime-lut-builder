{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUT Generator",
  "version": "1.0.0",
  "identifier": "io.github.ernestodiescholle.realtimelutbuilder",
  "build": {
    "beforeBuildCommand": "sh scripts/build-dist.sh",
    "beforeDevCommand": "sh scripts/build-dist.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LUT Generator",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 620,
        "dragDropEnabled": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
